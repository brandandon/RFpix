<!--
  MainWindow.axaml - the layout of the main window.

  The window is split into two columns:
    - left (220 pixels wide): the sidebar with the app name and the page list
    - right (the rest, written "*"): the current page
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RFpix.MainWindow"
        Title="RFpix"
        Icon="/Assets/RFpix.ico"
        Width="1200" Height="760"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="220,*">

    <!-- Sidebar -->
    <Border Grid.Column="0"
            Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
      <DockPanel Margin="12">
        <!-- The RFpix logo above the page list. -->
        <Image DockPanel.Dock="Top"
               Source="/Assets/RFpix-logo.png"
               Width="190" HorizontalAlignment="Left"
               Margin="6,4,6,20"
               RenderOptions.BitmapInterpolationMode="HighQuality"
               ToolTip.Tip="RFpix: images over the air" />

        <!-- Version number pinned to the bottom of the sidebar. -->
        <TextBlock x:Name="VersionText"
                   DockPanel.Dock="Bottom"
                   Classes="Hint" FontSize="12"
                   Margin="12,0,12,4" />

        <!-- The page list. Picking one runs OnNavSelectionChanged in MainWindow.axaml.cs.
             Each item's Tag is the name the code uses to find the page. -->
        <ListBox x:Name="NavList"
                 Background="Transparent"
                 SelectionChanged="OnNavSelectionChanged">
          <ListBoxItem Content="TX/RX"    Tag="TxRx" />
          <ListBoxItem Content="Gallery"  Tag="Gallery" />
          <ListBoxItem Content="Settings" Tag="Settings" />
          <ListBoxItem Content="Alpha Testing" Tag="Alpha" />
        </ListBox>
      </DockPanel>
    </Border>

    <!-- The pages live in here (put in by the code). Once opened, a page stays in place and is
         only hidden while another is showing, so coming back to it is instant. -->
    <Panel Grid.Column="1"
           x:Name="PageHost"
           Margin="32,24" />

  </Grid>
</Window>
