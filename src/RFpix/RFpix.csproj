<!--
  RFpix.csproj - the "recipe" for building RFpix.
  It says what kind of program this is, which .NET version it uses,
  and which add-on libraries (NuGet packages) it needs.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A Windows program with a window (no black console box behind it). -->
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 is the current long-term-support version. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- Warns us when something could be "empty" (null) by mistake. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>RFpix</RootNamespace>
    <AssemblyName>RFpix</AssemblyName>
    <!-- "-beta" shows as "0.5.2 beta" in the program; Windows' own file version stays 0.5.2. -->
    <Version>0.5.2-beta</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>RFpix</Product>
    <Description>Digital SSTV (HamDRM) for ham radio</Description>
    <!-- The icon Windows shows for RFpix.exe (in File Explorer and when pinned). -->
    <ApplicationIcon>Assets\RFpix.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Windows: 64-bit only, like the Magick.NET picture library it uses there. The Mac build
       is made for both kinds of Mac (Intel and Apple Silicon), so it isn't tied to one. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!--
    Hamlib, the radio-control library (LGPL licence), for Windows.
    The first build downloads Hamlib's official Windows package from GitHub, checks it's
    exactly the expected file (its SHA-256 fingerprint), and unpacks it under obj\.
    Its DLLs are then copied next to RFpix.exe. The Mac package carries its own copy, built
    from Hamlib's source by tools/mac/package.sh. On Linux, RFpix uses the system's hamlib.
  -->
  <PropertyGroup>
    <HamlibVersion>4.7.2</HamlibVersion>
    <HamlibSha256>8553bc6c5c6032e8debf99c017e98f58fed7e07e7c25d04815dc3e8bbe3304c7</HamlibSha256>
    <HamlibDir>$(MSBuildProjectDirectory)\obj\hamlib\</HamlibDir>
    <HamlibBin>$(HamlibDir)hamlib-w64-$(HamlibVersion)\bin\</HamlibBin>
    <!-- A one-file RFpix.exe carries the Hamlib DLLs inside and unpacks them when it starts. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <Target Name="GetHamlib" BeforeTargets="AssignTargetPaths" Condition="'$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <HamlibZip>$(HamlibDir)hamlib-w64-$(HamlibVersion).zip</HamlibZip>
    </PropertyGroup>
    <DownloadFile Condition="!Exists('$(HamlibBin)libhamlib-4.dll')" Retries="3"
                  SourceUrl="https://github.com/Hamlib/Hamlib/releases/download/$(HamlibVersion)/hamlib-w64-$(HamlibVersion).zip"
                  DestinationFolder="$(HamlibDir)" />
    <VerifyFileHash Condition="!Exists('$(HamlibBin)libhamlib-4.dll')" File="$(HamlibZip)" Hash="$(HamlibSha256)" />
    <Unzip Condition="!Exists('$(HamlibBin)libhamlib-4.dll')" SourceFiles="$(HamlibZip)" DestinationFolder="$(HamlibDir)" />
    <ItemGroup>
      <None Include="$(HamlibBin)libhamlib-4.dll" Link="libhamlib-4.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(HamlibBin)libgcc_s_seh-1.dll" Link="libgcc_s_seh-1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(HamlibBin)libwinpthread-1.dll" Link="libwinpthread-1.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(HamlibBin)libusb-1.0.dll" Link="libusb-1.0.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <None Include="$(HamlibDir)hamlib-w64-$(HamlibVersion)\COPYING.LIB.txt" Link="hamlib-licence.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!-- The tests may use a few hooks kept out of the program's public surface. -->
    <InternalsVisibleTo Include="RFpix.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pictures built into the program: the icon (window and taskbar) and the logo. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\TestPictures\**" />
    <!-- The test transmissions' pictures, read with GetManifestResourceStream. -->
    <EmbeddedResource Include="Assets\TestPictures\*.jpg" LogicalName="RFpix.TestPictures.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avalonia draws the windows, buttons and pages. -->
    <PackageReference Include="Avalonia" Version="11.3.0" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.0" />
    <!-- The "Fluent" look, including automatic light and dark themes. -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.0" />
    <!-- Avalonia uses this for Linux's D-Bus. Its version 0.21.2 has a security
         problem (GHSA-xrw6-gwf8-vvr9), so we ask for the fixed 0.21.3. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <!-- NAudio talks to Windows' own sound system (WASAPI). On the Mac, RFpix talks to
         Core Audio itself (Audio/CoreAudio), so nothing extra is needed there. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- CoreJ2K reads JPEG 2000 pictures, which EasyPal sends by default. Written in C#,
         so it works on Windows, Linux and Mac alike (BSD licence). -->
    <PackageReference Include="CoreJ2K" Version="2.3.3.91" />
    <!-- Magick.NET (ImageMagick for .NET, Apache licence) opens pictures of nearly any kind
         for sending, and makes and reads JPEG and AVIF (the RFpix-only, smaller format). -->
    <PackageReference Include="Magick.NET-Q8-x64" Version="14.17.2" Condition="'$(OS)' == 'Windows_NT'" />
    <!-- On the Mac (and Linux) the "AnyCPU" package, which carries the library for Intel and Apple Silicon. -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" Condition="'$(OS)' != 'Windows_NT'" />
    <!-- Uploading pictures to a website: FTP and FTPS (FluentFTP, MIT), SFTP (SSH.NET, MIT),
         and keeping the password encrypted on Windows (ProtectedData, MIT). -->
    <PackageReference Include="FluentFTP" Version="52.1.0" />
    <PackageReference Include="SSH.NET" Version="2025.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

</Project>
