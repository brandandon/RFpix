<!--
  SettingsPage.axaml - the Settings page, in three tabs:
    Radio - how RFpix reaches and keys the radio (the RadioPage control), and below that the
            radio's sound devices (receive input and send output)
    Misc  - your callsign, waterfall text, the colour theme, and sound-card calibration
    FTP server - copies of pictures for a website, and uploading them (the FtpPage control)
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RFpix.Views"
             x:Class="RFpix.Views.SettingsPage">
  <Grid RowDefinitions="Auto,*" RowSpacing="6">
    <TextBlock Grid.Row="0" Classes="PageTitle" Text="Settings" />
    <TabControl Grid.Row="1" x:Name="Tabs" Padding="0,12,0,0">
      <!-- Radio: what was the Radio page -->
      <TabItem Header="Radio" FontSize="16">
        <views:RadioPage x:Name="RadioTab" FontSize="14" />
      </TabItem>

      <!-- Misc: callsign, theme, and calibration when it comes -->
      <TabItem Header="Misc" FontSize="16">
        <ScrollViewer FontSize="14">
          <StackPanel Spacing="22" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="6">
              <TextBlock Text="Your callsign" FontWeight="SemiBold" />
              <TextBox x:Name="CallsignBox" Width="160" HorizontalAlignment="Left" MaxLength="9" Watermark="e.g. N0CALL"
                       TextChanged="OnCallsignChanged" LostFocus="OnCallsignLostFocus" />
              <TextBlock Classes="Hint" TextWrapping="Wrap"
                         Text="Sent with every transmission (your pictures and the tests); receivers show it. Up to 9 characters." />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="Your grid square (QTH)" FontWeight="SemiBold" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBox x:Name="GridBox" Width="160" MaxLength="6" Watermark="e.g. AA00aa"
                         TextChanged="OnGridChanged" LostFocus="OnGridLostFocus" />
                <TextBlock x:Name="GridProblem" Foreground="OrangeRed" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Classes="Hint" TextWrapping="Wrap"
                         Text="4 or 6 characters (such as AA00 or AA00aa). Templates can show it with %qth." />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="Waterfall text" FontWeight="SemiBold" />
              <TextBlock Classes="Hint" TextWrapping="Wrap"
                         Text="Written on everyone's waterfall before and after each of your pictures (not the test transmissions). Leave a box empty to send none. A short text is drawn big; a longer one wraps onto more lines, each about 2 seconds." />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Grid.Row="0" Text="Before the picture" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="WaterfallBeforeBox" Width="360" HorizontalAlignment="Left"
                         Watermark="e.g. CQ SSTV NET" TextChanged="OnWaterfallTextChanged" />
                <TextBlock Grid.Row="1" Text="After the picture" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="WaterfallAfterBox" Width="360" HorizontalAlignment="Left"
                         Watermark="e.g. 73 de N0CALL" TextChanged="OnWaterfallTextChanged" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="Theme" FontWeight="SemiBold" />
              <!-- Picking an item runs OnThemeChanged in SettingsPage.axaml.cs. -->
              <ComboBox x:Name="ThemeBox" Width="220" SelectionChanged="OnThemeChanged">
                <ComboBoxItem x:Name="FollowSystemItem" Content="Follow Windows" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
              </ComboBox>
            </StackPanel>

            <!-- New versions (Mac only for now: shown by UseMacWords). -->
            <StackPanel x:Name="UpdatesPanel" Spacing="6" IsVisible="False">
              <TextBlock Text="New versions" FontWeight="SemiBold" />
              <CheckBox x:Name="CheckForUpdatesBox" Content="Check for new versions of RFpix when it starts" />
            </StackPanel>

            <!-- Sound-card calibration -->
            <StackPanel Spacing="8">
              <TextBlock Text="Sound-card calibration" FontWeight="SemiBold" />
              <TextBlock x:Name="CalibrationHint" Classes="Hint" TextWrapping="Wrap"
                         Text="Every sound card's clock is a little fast or slow. RFpix measures the radio's sound input and output against the computer's clock for 2 minutes, then corrects for them when receiving and sending. The radio stays receiving: RFpix plays silence and doesn't key it. For the best result, first make sure Windows' clock is set right (Settings > Time &amp; language > Date &amp; time > Sync now)." />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4">
                <TextBlock Grid.Row="0" Text="Receive (input):" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="InputClockText" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Text="Send (output):" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="OutputClockText" TextWrapping="Wrap" />
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="CalibrateButton" Content="Measure (2 minutes)" Click="OnCalibrateClick" />
                <Button x:Name="ClearCalibrationButton" Content="Set back to none" Click="OnClearCalibrationClick"
                        ToolTip.Tip="Forgets the measurements: no correction when receiving or sending." />
              </StackPanel>
              <ProgressBar x:Name="CalibrationProgress" Width="360" HorizontalAlignment="Left" Minimum="0" Maximum="1" IsVisible="False" />
              <TextBlock x:Name="CalibrationStatus" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- FTP server: copies for a website, and uploading them -->
      <TabItem Header="FTP server" FontSize="16">
        <views:FtpPage x:Name="FtpTab" />
      </TabItem>
    </TabControl>

    <!-- The radio's sound devices. Shown on the Radio tab, under the Test PTT note (moved there
         when the page opens: RadioPage.Below). -->
            <StackPanel x:Name="AudioPanel" Grid.Row="1" IsVisible="False" Spacing="14">
              <TextBlock Text="Sound devices" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,0" />
              <StackPanel Spacing="6">
                <TextBlock Text="Receive: the radio's sound input" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="InputBox" Width="440" PlaceholderText="Pick the radio's USB audio device"
                            SelectionChanged="OnInputChanged" />
                  <Button Content="Refresh" Click="OnRefreshClick" />
                </StackPanel>
              </StackPanel>

              <StackPanel Spacing="6">
                <TextBlock Text="Send: the radio's sound output" FontWeight="SemiBold" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ComboBox x:Name="OutputBox" Width="440" PlaceholderText="Pick the radio's USB audio device"
                            SelectionChanged="OnOutputChanged" />
                  <Button Content="Refresh" Click="OnRefreshClick" />
                </StackPanel>
              </StackPanel>

              <TextBlock x:Name="DeviceProblemText" TextWrapping="Wrap" Foreground="OrangeRed" IsVisible="False" />
              <TextBlock x:Name="DeviceHint" Classes="Hint" TextWrapping="Wrap"
                         Text="Radios usually appear as &quot;USB Audio CODEC&quot;. Renaming them in Windows Sound settings (for example &quot;FT-991A&quot;) makes them easy to tell apart. Not your computer's own speakers or microphone." />
            </StackPanel>
  </Grid>
</UserControl>
