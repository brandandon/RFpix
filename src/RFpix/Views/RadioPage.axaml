<!--
  RadioPage.axaml - the Radio page. For now it only shows what is coming.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RFpix.Views.RadioPage">
  <StackPanel Spacing="8">
    <TextBlock Classes="PageTitle" Text="Radio" />
    <TextBlock Text="Radio control: frequency, CAT and PTT for your rig." TextWrapping="Wrap" />
    <TextBlock Classes="Hint" Text="Coming in milestone 2 (FT-991A and IC-9700 first)." />
  </StackPanel>
</UserControl>
