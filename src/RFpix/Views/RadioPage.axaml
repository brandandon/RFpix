<!--
  RadioPage.axaml - the Radio page: how RFpix reaches the radio (through Hamlib),
  how the transmitter is keyed, and a test. Once connected, the radio's frequency
  and mode are shown, updated every second.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RFpix.Views.RadioPage">
  <ScrollViewer>
    <StackPanel Spacing="18" MaxWidth="820" HorizontalAlignment="Left">
      <TextBlock Classes="PageTitle" Text="Radio" />

      <!-- Which radio -->
      <StackPanel Spacing="6">
        <TextBlock Text="Radio" FontWeight="SemiBold" />
        <ComboBox x:Name="RadioBox" Width="440" SelectionChanged="OnRadioChanged" />
        <TextBlock x:Name="RadioHint" Classes="Hint" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Only for "Other radio": which radio, from Hamlib's list (type part of the make or
           model to find it), or Hamlib's model number typed in -->
      <StackPanel x:Name="ModelPanel" Spacing="6">
        <TextBlock Text="Radio model" FontWeight="SemiBold" />
        <AutoCompleteBox x:Name="ModelBox" Width="440" FilterMode="Contains" MinimumPrefixLength="1"
                         MaxDropDownHeight="320" Watermark="Type the make or model, e.g. FT-991 or IC-7300" />
        <TextBlock Classes="Hint" TextWrapping="Wrap"
                   Text="Pick your radio from the list as you type. Hamlib's model number (such as 1035) can be typed instead." />
      </StackPanel>

      <!-- A radio on a COM port -->
      <StackPanel x:Name="SerialPanel" Spacing="6">
        <TextBlock Text="Control port" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ComboBox x:Name="PortBox" Width="560" PlaceholderText="Pick the radio's COM port" />
          <Button Content="Refresh" Click="OnRefreshPortsClick" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="24" Margin="0,6,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Baud rate" />
            <ComboBox x:Name="BaudBox" Width="140" />
          </StackPanel>
          <StackPanel x:Name="CivPanel" Spacing="6">
            <TextBlock Text="CI-V address (hex)" />
            <TextBox x:Name="CivBox" Width="100" Watermark="A2" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- A program sharing the radio (rigctld, flrig) -->
      <StackPanel x:Name="NetworkPanel" Spacing="6">
        <TextBlock Text="Address" FontWeight="SemiBold" />
        <TextBox x:Name="AddressBox" Width="260" Watermark="localhost:4532" />
      </StackPanel>

      <!-- Keying -->
      <StackPanel Spacing="8">
        <TextBlock Text="Transmit keying (PTT)" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="20">
          <RadioButton x:Name="PttCat" GroupName="Ptt" Content="CAT command" />
          <RadioButton x:Name="PttRts" GroupName="Ptt" Content="RTS line" />
          <RadioButton x:Name="PttDtr" GroupName="Ptt" Content="DTR line" />
          <RadioButton x:Name="PttVox" GroupName="Ptt" Content="VOX" />
        </StackPanel>
        <TextBlock Classes="Hint" TextWrapping="Wrap"
                   Text="VOX: the radio keys itself when RFpix's sound starts, so RFpix sends no key command. Turn VOX on in the radio and set its level so RFpix's audio trips it." />
        <CheckBox x:Name="DataModeBox"
                  Content="Switch the radio to data mode while transmitting (USB → USB-D), and back afterwards" />
      </StackPanel>

      <!-- Connect and test -->
      <StackPanel Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" MinWidth="120" />
          <Button x:Name="TestPttButton" Content="Test PTT (2 seconds)" Click="OnTestPttClick" IsEnabled="False"
                  ToolTip.Tip="Keys the transmitter for 2 seconds, then always releases it. Use a dummy load or low power on a clear frequency." />
        </StackPanel>
        <TextBlock x:Name="FrequencyText" FontSize="30" FontWeight="SemiBold" />
        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        <TextBlock Classes="Hint" TextWrapping="Wrap"
                   Text="Test PTT puts the radio on the air for 2 seconds (with no audio). Use a dummy load, or low power on a clear frequency. RFpix never leaves the transmitter keyed: a time limit always releases it." />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
