<!--
  WaterfallPictureWindow.axaml - "WF PIC" on the Send tab: pick a picture to draw on the
  waterfall in shades of grey. The preview shows how it will look; Send sends it.
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RFpix.Views.WaterfallPictureWindow"
        Title="Waterfall picture" Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20" Spacing="12">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <Button Content="Choose picture…" Click="OnChooseClick" />
      <TextBlock x:Name="FileText" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="360" />
    </StackPanel>
    <WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,24,6">
        <TextBlock Text="Size" VerticalAlignment="Center" />
        <ComboBox x:Name="SizeBox" Width="190" />
      </StackPanel>
      <CheckBox x:Name="InvertBox" Content="Invert (swap light and dark)" Margin="0,0,0,6" />
    </WrapPanel>
    <TextBlock Text="How it will look" Classes="Hint" FontSize="12" />
    <Border Background="#0B1A40" CornerRadius="4" Padding="6" Height="300" ClipToBounds="True">
      <Panel>
        <TextBlock x:Name="PreviewHint" Text="Choose a picture: a logo or a simple drawing works best." Foreground="#C9D4E3"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="12" />
        <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
      </Panel>
    </Border>
    <TextBlock x:Name="TimeText" Classes="Hint" />
    <TextBlock Classes="Hint" FontSize="12" TextWrapping="Wrap"
               Text="Drawn 98 pixels across (300 to 2600 Hz) in shades of grey: white is full strength, black is silent. Shown here as on a waterfall that scrolls down." />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="SendButton" Content="Send" Classes="accent" MinWidth="90" Click="OnSendClick" IsEnabled="False" IsDefault="True" />
      <Button Content="Cancel" MinWidth="90" Click="OnCancelClick" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</Window>
