<!--
  GalleryPage.axaml - the Gallery page. For now it only shows what is coming.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RFpix.Views.GalleryPage">
  <StackPanel Spacing="8">
    <TextBlock Classes="PageTitle" Text="Gallery" />
    <TextBlock Text="All the images you have received and sent." TextWrapping="Wrap" />
    <TextBlock Classes="Hint" Text="Coming in milestone 4." />
  </StackPanel>
</UserControl>
