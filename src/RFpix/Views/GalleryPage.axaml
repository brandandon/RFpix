<!--
  GalleryPage.axaml - the Gallery page: every picture received and sent, newest first,
  grouped by day; received pictures in two halves, digital (HamDRM) and analog SSTV. Click one for its details (who, when, the settings it came with, the
  signal); double-click to open it full size. "Send this picture" opens it on the Send tab.
  The pictures are the files in the Received and Sent folders; the tiles are made in the code.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RFpix.Controls"
             x:Class="RFpix.Views.GalleryPage">
  <UserControl.Styles>
    <Style Selector="Button.Tile">
      <Setter Property="Width" Value="156" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Margin" Value="0,0,10,10" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.Tile.Selected">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.DayHeading">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="Margin" Value="0,4,0,6" />
    </Style>
    <Style Selector="TextBlock.DetailLabel">
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,0,12,4" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
    <TextBlock Grid.Row="0" Classes="PageTitle" Text="Gallery" />

    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TabStrip Grid.Column="0" x:Name="Tabs" SelectedIndex="0" SelectionChanged="OnTabChanged">
        <TabStripItem x:Name="ReceivedTab" Content="Received" FontSize="16" />
        <TabStripItem x:Name="SentTab" Content="Sent" FontSize="16" />
      </TabStrip>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Find" VerticalAlignment="Center" />
        <TextBox x:Name="FindBox" Width="200" Watermark="Callsign or name" />
        <Button Content="Open folder" Click="OnOpenFolderClick" />
        <Button Content="Change folder…" Click="OnChangeFolderClick"
                ToolTip.Tip="Choose another folder for your received and sent pictures (a bigger drive, say). RFpix can move the pictures you have there." />
      </StackPanel>
    </Grid>

    <!-- Where the pictures are; and, after Change folder…, whether to move them there -->
    <StackPanel Grid.Row="2" Spacing="6">
      <TextBlock x:Name="WhereText" Classes="Hint" FontSize="12" TextWrapping="Wrap" />
      <Border x:Name="MovePanel" IsVisible="False" Padding="12" CornerRadius="6"
              Background="{DynamicResource SystemControlBackgroundListLowBrush}">
        <StackPanel Spacing="8">
          <TextBlock x:Name="MoveQuestion" TextWrapping="Wrap" FontWeight="SemiBold" />
          <StackPanel x:Name="MoveButtons" Orientation="Horizontal" Spacing="8">
            <Button Content="Move my pictures there" Click="OnMoveClick" />
            <Button Content="Start empty there" Click="OnStartEmptyClick" />
            <Button Content="Cancel" Click="OnMoveCancelClick" />
          </StackPanel>
          <TextBlock x:Name="MoveStatus" TextWrapping="Wrap" IsVisible="False" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="3" ColumnDefinitions="*,340" ColumnSpacing="20" Margin="0,6,0,0">
      <!-- Sent: the pictures, by day -->
      <!-- (Flex: the lists scroll in the room there is, rather than asking for all their height) -->
      <controls:Flex Grid.Column="0" Min="200">
        <ScrollViewer x:Name="TilesScroll">
          <StackPanel x:Name="DaysPanel" Margin="0,0,12,12" />
        </ScrollViewer>
      </controls:Flex>
      <!-- Received: digital pictures on the left, analog on the right, each by day -->
      <Grid Grid.Column="0" x:Name="SplitPanel" ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="False">
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
          <TextBlock x:Name="DigitalHeading" Text="Digital" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
          <controls:Flex Grid.Row="1" Min="200">
            <ScrollViewer>
              <StackPanel x:Name="DigitalDays" Margin="0,0,12,12" />
            </ScrollViewer>
          </controls:Flex>
          <TextBlock Grid.Row="1" x:Name="DigitalEmpty" Classes="Hint" TextWrapping="Wrap" IsVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="260" />
        </Grid>
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
          <TextBlock x:Name="AnalogHeading" Text="Analog" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,6" />
          <controls:Flex Grid.Row="1" Min="200">
            <ScrollViewer>
              <StackPanel x:Name="AnalogDays" Margin="0,0,12,12" />
            </ScrollViewer>
          </controls:Flex>
          <TextBlock Grid.Row="1" x:Name="AnalogEmpty" Classes="Hint" TextWrapping="Wrap" IsVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="260" />
        </Grid>
      </Grid>
      <TextBlock Grid.Column="0" x:Name="EmptyText" Classes="Hint" TextWrapping="Wrap" IsVisible="False"
                 HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" MaxWidth="420" />

      <!-- The picture clicked -->
      <Border Grid.Column="1" x:Name="DetailsPanel" IsVisible="False" VerticalAlignment="Top" CornerRadius="6" Padding="14"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
        <StackPanel Spacing="10">
          <Border Height="230" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}"
                  DoubleTapped="OnDetailDoubleTapped" ToolTip.Tip="Double-click to open it full size">
            <Image x:Name="DetailImage" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality" />
          </Border>
          <TextBlock x:Name="DetailName" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap" />
          <Grid x:Name="DetailGrid" ColumnDefinitions="Auto,*" />
          <WrapPanel>
            <Button x:Name="SendThisButton" Content="Send this picture" Classes="accent" Click="OnSendThisClick" Margin="0,0,8,8" />
            <Button Content="Show in folder" Click="OnShowInFolderClick" Margin="0,0,8,8" />
            <Button x:Name="DeleteButton" Content="Delete" Click="OnDeleteClick" Margin="0,0,8,8" />
          </WrapPanel>
          <TextBlock x:Name="DetailStatus" Classes="Hint" FontSize="12" TextWrapping="Wrap"
                     Text="Send this picture opens it on the Send tab, ready to fit and send. Double-click the picture to open it full size." />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
