<!--
  TemplatePickerWindow.axaml - "Template…" on the Send tab: every overlay template, drawn on
  your picture, to pick from. Click one to use it (or None for no template).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="RFpix.Views.TemplatePickerWindow"
        Title="Pick a template" Width="900" Height="640" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="12">
    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="Pick a template" FontSize="20" FontWeight="SemiBold" />
      <TextBlock Classes="Hint" TextWrapping="Wrap"
                 Text="Each is shown on your picture. Click one to use it. The template is drawn at the size the picture goes out, so it fits both large digital pictures and small analog ones." />
    </StackPanel>
    <ScrollViewer Grid.Row="1">
      <WrapPanel x:Name="TilesPanel" />
    </ScrollViewer>
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewButton" Content="New template…" Click="OnNewClick"
                ToolTip.Tip="Make a template of your own, starting from a blank one." />
        <Button Content="Open templates folder" Click="OnOpenFolderClick"
                ToolTip.Tip="Your templates are files here: copy them to back them up, or to share them with the net." />
      </StackPanel>
      <Button Grid.Column="2" Content="Cancel" MinWidth="90" Click="OnCancelClick" IsCancel="True" />
    </Grid>
  </Grid>
</Window>
