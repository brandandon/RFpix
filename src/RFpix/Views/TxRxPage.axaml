<!--
  TxRxPage.axaml - the TX/RX page: receiving and sending on one page, a tab for each.
  Both keep working whichever tab is showing: RFpix goes on listening while you're on
  the Send tab, and a transmission carries on while you look at the Receive tab.
  Both tabs stay in place; the one not chosen is only hidden, so switching is instant.
  Above the tabs (so it shows on either): a bar when a station asks for missing pieces
  of a picture you sent (BSR), offering to send them.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:RFpix.Views"
             x:Class="RFpix.Views.TxRxPage">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" RowSpacing="6">
    <TextBlock Grid.Row="0" Classes="PageTitle" Text="TX/RX" />

    <!-- A request for missing pieces of one of your pictures -->
    <Border Grid.Row="1" x:Name="RequestBar" IsVisible="False" CornerRadius="6" Padding="14,10" Margin="0,0,0,6"
            Background="#33E8A200" BorderBrush="#99E8A200" BorderThickness="1">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
          <TextBlock x:Name="RequestTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="RequestText" FontSize="13" TextWrapping="Wrap" />
          <ProgressBar x:Name="RequestProgress" Minimum="0" Maximum="1" IsVisible="False" Margin="0,4,0,0" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="SendPiecesButton" Content="Send the pieces" Classes="accent"
                Click="OnSendPiecesClick" VerticalAlignment="Center" MinWidth="130" />
        <Button Grid.Column="2" x:Name="NotNowButton" Content="Not now" Click="OnNotNowClick" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- A request for someone else's picture: a note for a few seconds -->
    <Border Grid.Row="2" x:Name="NoteBar" IsVisible="False" CornerRadius="6" Padding="14,8" Margin="0,0,0,6"
            HorizontalAlignment="Left" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
      <TextBlock x:Name="NoteText" FontSize="13" TextWrapping="Wrap" />
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TabStrip Grid.Column="0" x:Name="Tabs" SelectedIndex="0" SelectionChanged="OnTabChanged">
        <TabStripItem x:Name="ReceiveTabItem" Content="Receive" FontSize="16" />
        <TabStripItem Content="Send" FontSize="16" />
      </TabStrip>
      <!-- The Receive tab in a window of its own, to see it and the Send tab together -->
      <Button Grid.Column="1" x:Name="PopOutButton" Content="Pop out Receive" Click="OnPopOutClick" VerticalAlignment="Center"
              ToolTip.Tip="Moves the Receive tab into a window of its own, so you can watch receiving while you send (on a second monitor, say). Listening carries on. Close that window to bring it back." />
    </Grid>
    <Panel Grid.Row="4" x:Name="TabsHost" Margin="0,12,0,0">
      <views:ReceivePage x:Name="ReceiveTab" FontSize="14" />
      <views:SendPage x:Name="SendTab" FontSize="14" IsVisible="False" />
    </Panel>
  </Grid>
</UserControl>
