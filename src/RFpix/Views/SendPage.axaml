<!--
  SendPage.axaml - the Send tab of the TX/RX page: sending your own pictures.
  Being built: picking a picture, fitting it to the transmit time, and sending it.
  The built-in test transmissions are on the Alpha Testing page.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RFpix.Views.SendPage">
  <StackPanel Spacing="10" MaxWidth="820" HorizontalAlignment="Left">
    <TextBlock Text="Sending your own pictures is being built." FontWeight="SemiBold" />
    <TextBlock Classes="Hint" TextWrapping="Wrap"
               Text="The built-in test transmissions are on the Alpha Testing page. RFpix goes on listening on the Receive tab while you send from there." />
  </StackPanel>
</UserControl>
