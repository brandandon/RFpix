<!--
  ReceivePage.axaml - the Receive tab of the TX/RX page.
  Check the level, watch the waterfall, and see each HamDRM picture as it's received
  (saved automatically to the received folder). The sound device is chosen on the
  Settings page.

  The page is a Grid with rows stacked top to bottom. "Auto" rows are as tall as
  their contents; the "*" row (waterfall and picture) takes all the space that's left.
-->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:RFpix.Controls"
             x:Class="RFpix.Views.ReceivePage">
  <UserControl.Styles>
    <!-- The boxes showing the received transmission's settings, like the Send tab's drop-downs -->
    <Style Selector="Border.Setting">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,2" />
      <Setter Property="Margin" Value="0,2,6,2" />
      <Setter Property="MinWidth" Value="62" />
    </Style>
    <Style Selector="TextBlock.SettingLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="TextBlock.SettingValue">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="PageGrid" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14">

    <!-- Row 0: start/stop, record, play a recording on the left; the level meter, format and the
         signal boxes beside them, wrapping in a narrow window -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
     <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
      <Button x:Name="StartButton" Content="Start listening" Click="OnStartStopClick" MinWidth="130" />
      <Button x:Name="RecordButton" Content="Record" Click="OnRecordClick" MinWidth="130" IsEnabled="False"
              ToolTip.Tip="Save what the radio hears as a WAV file in Documents\RFpix\Recordings, starting 30 seconds before you press it. Handy for a transmission that didn't decode: it can be played back and studied." />
      <Button x:Name="PlayButton" Content="Play recording…" Click="OnPlayClick" MinWidth="140"
              ToolTip.Tip="Play a WAV recording into the waterfall instead of the radio. Handy for testing, or for recordings other stations send you." />
     </StackPanel>
      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Level" VerticalAlignment="Center" />
          <ProgressBar x:Name="LevelMeter" Minimum="0" Maximum="100" Width="220" Height="14"
                       ToolTip.Tip="0 dB is the loudest possible. Red means too loud: turn the radio's USB/data output level down." />
          <TextBlock x:Name="LevelText" Classes="Hint" VerticalAlignment="Center" MinWidth="60" Text="Not listening" />
        </StackPanel>
        <TextBlock x:Name="FormatText" Classes="Hint" FontSize="12" />
        <!-- While recording: how long and how big; afterwards: where it was saved -->
        <TextBlock x:Name="RecordText" FontSize="12" IsVisible="False" />
        <!-- A problem (otherwise hidden). Then the HamDRM signal's offset, clock, strength and quality,
             one fixed-size box each; quality green when good enough for the settings, red when not.
             The boxes show only while a picture is arriving; their space stays, empty, otherwise. -->
        <TextBlock x:Name="SignalText" FontWeight="SemiBold" IsVisible="False" />
        <Panel x:Name="BoxesArea">
        <StackPanel x:Name="DigitalBoxes" Opacity="0" IsHitTestVisible="False">
        <WrapPanel x:Name="SignalPanel">
          <Border Classes="Setting" Width="104"><StackPanel><TextBlock Classes="SettingLabel" Text="Offset" /><TextBlock x:Name="SignalOffset" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="92"><StackPanel><TextBlock Classes="SettingLabel" Text="Clock" /><TextBlock x:Name="SignalClock" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="76"><StackPanel><TextBlock Classes="SettingLabel" Text="Strength" /><TextBlock x:Name="SignalStrength" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" x:Name="QualityBox" Width="110"
                  ToolTip.Tip="Green: good enough for the settings being sent. Red: too weak or noisy for them; pieces will be lost.">
            <StackPanel><TextBlock x:Name="QualityLabel" Classes="SettingLabel" Text="Quality" /><TextBlock x:Name="SignalQuality" Classes="SettingValue" /></StackPanel>
          </Border>
        </WrapPanel>
        <!-- The transmission's settings and callsign (from its FAC and the file's name), one fixed-size
             box each. While an analog picture arrives, AnalogBoxes show in the same place instead. -->
        <WrapPanel x:Name="HeardPanel">
          <Border Classes="Setting" Width="64"><StackPanel><TextBlock Classes="SettingLabel" Text="Mode" /><TextBlock x:Name="HeardMode" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="84"><StackPanel><TextBlock Classes="SettingLabel" Text="Bandwidth" /><TextBlock x:Name="HeardBandwidth" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="76"><StackPanel><TextBlock Classes="SettingLabel" Text="QAM" /><TextBlock x:Name="HeardQam" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="84"><StackPanel><TextBlock Classes="SettingLabel" Text="Interleave" /><TextBlock x:Name="HeardInterleave" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="84"><StackPanel><TextBlock Classes="SettingLabel" Text="Protection" /><TextBlock x:Name="HeardProtection" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="96"><StackPanel><TextBlock Classes="SettingLabel" Text="Reed-Solomon" /><TextBlock x:Name="HeardReedSolomon" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="110"><StackPanel><TextBlock Classes="SettingLabel" Text="From" /><TextBlock x:Name="HeardCallsign" Classes="SettingValue" /></StackPanel></Border>
        </WrapPanel>
        <!-- Analog SSTV: the mode, "Line 123 of 256", and the sender's callsign from its FSK ID -->
        </StackPanel>
        <WrapPanel x:Name="AnalogBoxes" Opacity="0" IsHitTestVisible="False" VerticalAlignment="Top">
          <Border Classes="Setting" Width="110"><StackPanel><TextBlock Classes="SettingLabel" Text="Mode" /><TextBlock x:Name="AnalogMode" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="64"><StackPanel><TextBlock Classes="SettingLabel" Text="Line" /><TextBlock x:Name="AnalogLine" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="64"><StackPanel><TextBlock Classes="SettingLabel" Text="of" /><TextBlock x:Name="AnalogOf" Classes="SettingValue" /></StackPanel></Border>
          <Border Classes="Setting" Width="110"
                  ToolTip.Tip="The sender's callsign, from the FSK ID that MMSSTV and QSSTV send after a picture.">
            <StackPanel><TextBlock Classes="SettingLabel" Text="From" /><TextBlock x:Name="AnalogFrom" Classes="SettingValue" /></StackPanel>
          </Border>
        </WrapPanel>
        </Panel>
        <!-- How well the settings are being read ("FAC 25/25 ok"), or "Reading the settings…" -->
        <TextBlock x:Name="TransmissionText" Classes="Hint" FontSize="12" />
        <!-- The file arriving: name, size and how far along -->
        <TextBlock x:Name="FileText" />
        <!-- The last RFpix test transmission received, and the log of them all -->
        <StackPanel x:Name="TestPanel" Orientation="Horizontal" Spacing="10" IsVisible="False">
          <TextBlock x:Name="TestResultText" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="900" />
          <Button Content="Open test results" Click="OnOpenTestResultsClick" Padding="8,2"
                  ToolTip.Tip="Every test transmission received, one line each (Documents\RFpix\Test results.csv; opens in Excel)." />
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- Row 1: the waterfall (from the left edge to the Record button's right edge, set in the
         code) and the last picture received (the rest of the width) -->
    <Grid Grid.Row="1" x:Name="WaterfallRow" ColumnDefinitions="276,*" ColumnSpacing="14">
      <Border Grid.Column="0" CornerRadius="6" ClipToBounds="True" MinHeight="180"
              BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
        <controls:WaterfallControl x:Name="Waterfall"
                                   PointerMoved="OnWaterfallPointerMoved"
                                   PointerExited="OnWaterfallPointerExited" />
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="6">
        <!-- Flex: the picture takes the room there is, rather than asking for its full size -->
        <controls:Flex Grid.Row="0" Min="120">
        <Border CornerRadius="6" ClipToBounds="True"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
          <Panel>
            <TextBlock x:Name="PicturePlaceholder" Classes="Hint" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16"
                       Text="Received pictures appear here, and are saved automatically." />
            <Image x:Name="PictureImage" Stretch="Uniform" />
          </Panel>
        </Border>
        </controls:Flex>
        <TextBlock Grid.Row="1" x:Name="PictureCaption" TextWrapping="Wrap" />
        <!-- While a picture is incomplete: ask its sender for the missing pieces (BSR) -->
        <Border Grid.Row="2" x:Name="MissingPanel" IsVisible="False" CornerRadius="6" Padding="12,10"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1">
          <StackPanel Spacing="6">
            <TextBlock Text="Missing pieces" FontWeight="SemiBold" />
            <WrapPanel>
              <ComboBox x:Name="MissingBox" MinWidth="360" Margin="0,0,10,4" SelectionChanged="OnMissingChanged" />
              <Button x:Name="AskButton" Content="Ask for them (BSR)" Classes="accent" Click="OnAskClick" MinWidth="150" Margin="0,0,0,4" />
            </WrapPanel>
            <ProgressBar x:Name="AskProgress" Minimum="0" Maximum="1" IsVisible="False" />
            <TextBlock x:Name="AskText" Classes="Hint" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Button Grid.Row="3" Content="Open received folder" Click="OnOpenFolderClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
      </Grid>
    </Grid>

    <!-- Row 2: frequency under the mouse, and a hint -->
    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
      <TextBlock x:Name="PointerFrequencyText" Grid.Column="0" MinWidth="140" FontWeight="SemiBold" />
      <TextBlock Grid.Column="1" Classes="Hint" HorizontalAlignment="Right"
                 Text="SSTV" />
    </Grid>

    <!-- Row 3: problems are explained here -->
    <Border Grid.Row="3" x:Name="ErrorPanel" IsVisible="False"
            Padding="14" CornerRadius="6"
            Background="#33E5484D" BorderBrush="#99E5484D" BorderThickness="1">
      <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
